#!/data/data/com.termux/files/usr/bin/bash
# blank — 백지 앱의 채점기. 폰에 이미 로그인된 claude CLI 로 무료로 돌린다.
#
# 앱 → 터미널 : Download/blank/ 아래 요청 파일 + Termux RUN_COMMAND
# 터미널 → 앱 : am broadcast 만 쓴다 (앱은 남이 만든 파일을 읽지 못한다)
#
# 요청 파일 형식
#   op=grade|normalize
#   req=<요청 id>
#   model=<모델 id>
#   image=<사진 절대경로 또는 빈 값>
#   ---
#   <요소표 JSON (grade) 또는 제목 (normalize)>
#   ===
#   <재현물 텍스트 (grade) 또는 원본 (normalize)>
set -u

export HOME="${HOME:-/data/data/com.termux/files/home}"
export PATH="$HOME/.local/bin:$HOME/bin:/data/data/com.termux/files/usr/bin:${PATH:-}"

# RUN_COMMAND 백그라운드 실행은 로그인 셸이 아니다. 그리고 이 스크립트가 Claude Code
# 세션 안에서 실행되면 그 세션의 루프백 프록시를 물려받는데, 세션이 끝나면 그 포트가
# 사라져 이후 claude 호출이 전부 Connection refused 로 죽는다. 루프백만 걷어낸다.
for v in http_proxy https_proxy all_proxy HTTP_PROXY HTTPS_PROXY ALL_PROXY; do
  case "${!v:-}" in *127.0.0.1*|*localhost*) unset "$v" ;; esac
done
unset CLAUDECODE CLAUDE_CODE_CHILD_SESSION CLAUDE_CODE_SESSION_ID \
      CLAUDE_CODE_MESSAGING_SOCKET CLAUDE_CODE_MESSAGING_TOKEN \
      CLAUDE_CODE_BRIDGE_SESSION_ID CLAUDE_CODE_ENTRYPOINT \
      CLAUDE_CODE_PROXY_RESOLVES_HOSTS CLAUDE_PID CLAUDE_EFFORT AI_AGENT

PKG="com.blank.app"
RECEIVER="$PKG/.cli.CommandReceiver"
ACTION="$PKG.CMD"
BR="/storage/emulated/0/Download/blank"
ASSETS="${BLANK_ASSETS:-$HOME/blank-page/app/src/main/assets}"
LOG="$BR/blank.log"
# 브로드캐스트 한 조각의 최대 길이. binder 트랜잭션 한도(1MB)에 여유를 크게 둔다.
CHUNK=48000

log() { mkdir -p "$BR"; printf '%s %s\n' "$(date +%H:%M:%S)" "$*" >> "$LOG"; }

send() { # send <cmd> <req> [extra am args...]
  local cmd="$1" req="$2"; shift 2
  am broadcast -n "$RECEIVER" -a "$ACTION" --include-stopped-packages \
     -e cmd "$cmd" -e req "$req" "$@" >/dev/null 2>&1
}

send_json() { # send_json <req> <json> [추가 am 인자...]
  local req="$1" json="$2"; shift 2
  local len i n part
  len=${#json}
  n=$(( (len + CHUNK - 1) / CHUNK )); [ "$n" -lt 1 ] && n=1
  for (( i=0; i<n; i++ )); do
    part="${json:$((i*CHUNK)):$CHUNK}"
    send result "$req" --ei part "$i" --ei parts "$n" -e json "$part" "$@"
    sleep 0.15
  done
  log "sent $req in $n part(s), $len bytes"
}

# 요청 파일 하나를 처리한다. 두 번 처리하지 않도록 .done 마커를 남긴다.
claim() {
  local f="$1"
  [ -f "$f.done" ] && return 1
  : > "$f.done"
  return 0
}

# claude 한 번 호출해서 structured_output 만 돌려준다.
#  - --output-format json (비스트리밍). 스트리밍은 조각이 수백 개라 폰에서 직렬화 비용만 더 든다.
#  - 측정하니 wall 의 90% 가 API 생성 시간이고 CLI 기동은 1.5초뿐이다. 그래서 상주 프로세스로
#    기동을 없애는 대신, 출력 토큰을 줄이는 쪽(2단계 분리)으로 간다.
ask() { # ask <prompt파일> <schema파일> <user메시지> [추가 플래그...]
  local sys="$1" schema="$2" user="$3"; shift 3
  local out
  out=$(timeout 240 claude -p "$user" \
        --output-format json \
        --json-schema "$(cat "$schema")" \
        --system-prompt "$(cat "$sys")" \
        --model "$MODEL" \
        --effort low \
        --strict-mcp-config --mcp-config '{"mcpServers":{}}' \
        --no-session-persistence \
        "$@" \
        --permission-mode dontAsk < /dev/null 2>>"$LOG")
  [ -z "$out" ] && return 1
  local json
  json=$(printf '%s' "$out" | jq -c '.structured_output // empty' 2>/dev/null)
  if [ -z "$json" ] || [ "$json" = "null" ]; then
    json=$(printf '%s' "$out" | jq -r '.result // empty' 2>/dev/null \
           | sed -e 's/^```json//' -e 's/^```//' -e 's/```$//' | jq -c . 2>/dev/null)
  fi
  [ -z "$json" ] && return 1
  printf '%s' "$json"
}

run_one() {
  local f="$1"
  [ -f "$f" ] || { log "no such request: $f"; return 1; }
  claim "$f" || { log "already done: $f"; return 0; }

  local op req model image kind body top bottom
  op=$(sed -n 's/^op=//p'    "$f" | head -1)
  kind=$(sed -n 's/^kind=//p' "$f" | head -1)
  req=$(sed -n 's/^req=//p'   "$f" | head -1)
  model=$(sed -n 's/^model=//p' "$f" | head -1)
  image=$(sed -n 's/^image=//p' "$f" | head -1)
  : "${op:=grade}" ; : "${model:=claude-opus-5}"
  [ -z "$req" ] && req="$(basename "$f")"

  # --- 이후가 본문, === 로 위/아래가 갈린다
  body=$(awk 'f{print} /^---$/{f=1}' "$f")
  top=$(printf '%s' "$body" | awk '/^===$/{exit} {print}')
  bottom=$(printf '%s' "$body" | awk 'f{print} /^===$/{f=1}')

  local sys schema user
  if [ "$op" = "normalize" ]; then
    sys="$ASSETS/normalize_prompt.txt"; schema="$ASSETS/normalize_schema.json"
    user="<종류>${kind:-mixed}</종류>
<제목>$top</제목>
<원본>
$bottom
</원본>"
  else
    sys="$ASSETS/grading_prompt.txt"; schema="$ASSETS/grading_schema.json"
    if [ -n "$image" ]; then
      user="<요소표>$top</요소표>
<재현물>
사진 경로: $image
$bottom
</재현물>"
    else
      user="<요소표>$top</요소표>
<재현물>
$bottom
</재현물>"
    fi
  fi
  [ -f "$sys" ] || { send failed "$req" -e reason "프롬프트 파일이 없습니다: $sys"; log "missing $sys"; return 1; }

  local t0=$(date +%s)
  log "run $op req=$req model=$model image=${image:-none}"
  MODEL="$model"

  # 사진이 있으면 Read 도구만 열어 그 폴더를 읽힌다. 없으면 도구를 통째로 끈다.
  local -a tools=()
  if [ -n "$image" ]; then
    tools=(--tools Read --add-dir "$(dirname "$image")")
  else
    tools=(--tools "")
  fi

  if [ "$op" = "normalize" ]; then
    send status "$req" -e text "정규화 중"
    local json
    json=$(ask "$sys" "$schema" "$user" "${tools[@]}") || {
      send failed "$req" -e reason "정규화 실패"; log "normalize failed $req"; return 1; }
    printf '%s' "$json" > "$BR/last_$req.json"
    log "done $req in $(( $(date +%s) - t0 ))s"
    send_json "$req" "$json"
    return 0
  fi

  # ---- 채점은 두 번에 나눈다 ----
  # 판정만 뽑으면 6~8초, 설명까지 한꺼번에 뽑으면 15~18초다(실측). 앱은 판정만 있으면
  # 점수·등급을 스스로 계산하고 원본을 열 수 있으므로, 사용자는 8초에 결과를 본다.
  # 이유·요약·조언은 그 뒤에 조용히 채워 넣는다.
  send status "$req" -e text "판정 중"
  local v1
  v1=$(ask "$ASSETS/grade1_prompt.txt" "$ASSETS/grade1_schema.json" "$user" "${tools[@]}") || {
    send failed "$req" -e reason "채점 실패 (1단계)"; log "stage1 failed $req"; return 1; }
  printf '%s' "$v1" > "$BR/last_$req.json"
  log "stage1 $req in $(( $(date +%s) - t0 ))s"
  send_json "$req" "$v1" --ei stage 1

  # 2단계: 1단계 판정을 그대로 물려주고 설명만 받는다 (판정을 다시 내리지 못하게 못박는다)
  local t1=$(date +%s)
  local user2="$user
<판정>$v1</판정>"
  local v2
  v2=$(ask "$ASSETS/grade2_prompt.txt" "$ASSETS/grade2_schema.json" "$user2" "${tools[@]}") || {
    log "stage2 failed $req (판정은 이미 전달됨)"; return 0; }
  printf '%s' "$v2" > "$BR/last_${req}_2.json"
  log "stage2 $req in $(( $(date +%s) - t1 ))s (합계 $(( $(date +%s) - t0 ))s)"
  send_json "$req" "$v2" --ei stage 2
}

case "${1:-help}" in
  run)   run_one "$2" ;;
  # RUN_COMMAND 가 막혔을 때를 위한 수동 경로. 아직 안 한 요청을 전부 처리한다.
  watch)
    log "watch start"
    while true; do
      for f in "$BR"/req_*.txt; do
        [ -e "$f" ] || continue
        [ -f "$f.done" ] && continue
        run_one "$f"
      done
      sleep 1
    done ;;
  drain)
    for f in "$BR"/req_*.txt; do
      [ -e "$f" ] || continue
      [ -f "$f.done" ] && continue
      run_one "$f"
    done ;;
  # 앱이 살아서 브로드캐스트를 받는지, DB 에 뭐가 들었는지 확인한다.
  # 앱 uid 에서는 am 이 리시버 반환값을 못 받아오므로, 앱이 파일에 쓰게 하고 그걸 읽는다.
  ping|dump)
    rm -f "$BR"/status_*.txt
    am broadcast -n "$RECEIVER" -a "$ACTION" --include-stopped-packages -e cmd "$1" >/dev/null 2>&1
    for _ in $(seq 1 20); do
      f=$(ls -t "$BR"/status_*.txt 2>/dev/null | head -1)
      [ -n "$f" ] && { echo "== 앱 응답 =="; cat "$f"; exit 0; }
      sleep 0.5
    done
    echo "앱이 응답하지 않습니다 (설치 여부·강제종료 확인)"; exit 1 ;;
  log)   tail -n "${2:-40}" "$LOG" ;;
  clean) rm -f "$BR"/req_*.txt "$BR"/req_*.done; echo "cleaned" ;;
  *) cat <<'USAGE'
blank — 백지 앱 채점기

  blank run <요청파일>   요청 하나를 처리한다 (앱이 RUN_COMMAND 로 부른다)
  blank watch            RUN_COMMAND 가 막혔을 때 요청 폴더를 계속 훑는다
  blank drain            지금 밀려 있는 요청만 처리하고 끝낸다
  blank ping             앱이 브로드캐스트를 받는지 확인
  blank dump             앱 DB 상태(회차·채점 대기) 확인
  blank log [n]          최근 로그
  blank clean            요청 파일 정리
USAGE
    ;;
esac
